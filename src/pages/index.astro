---
import Layout from '../components/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Get all blog posts using Astro's content collections with error handling
let sortedPosts: CollectionEntry<"blog">[] = [];
try {
  const allPosts = await getCollection('blog');
  sortedPosts = allPosts
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3);
} catch (error) {
  console.error('Error loading blog posts:', error);
  // Fallback to empty array if content collections fail
  sortedPosts = [];
}
---
<head>
<style>
h1 {text-align: center;}
p {text-align: center;}
div {text-align: center;}
</style>
</head>
<body>
<Layout title="Headlines, Hootsuite, Hoops." description="The digital diary of Alexander J. Taylor." showSidebar={false}>
  <div class="landing-page">
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">“Your whole life can change with one book.”</h1>
        <p class="hero-subtitle"> - Malcolm X.</p>
        <div class="hero-description">
          <h3>I'm Alexander,</h3>
          <p>an early career professional<br> with a passion for storytelling and digital media.</p>
        </div>
        <hr class="hero-rule" />
        <div class="hero-actions">
          <a href={`${import.meta.env.BASE_URL}blog`} class="btn btn-secondary">My Work</a>
          <a href={`${import.meta.env.BASE_URL}about`} class="btn btn-secondary">Contact Me</a>
        </div>
      </div>
    </section>

    <section class="demo-section" id="demo">
      <div class="container">
        <h2 class="section-title">Recent Posts</h2>
        <p class="demo-description">
         Read my latest posts below.
        </p>

        {sortedPosts.length > 0 && (
          <div class="demo-posts">
            <div class="demo-posts">
              {sortedPosts.map(post => (
                <article class="demo-post-card">
                  <h3 class="demo-post-title">
                    <a href={`${import.meta.env.BASE_URL}${post.slug}`}>{post.data.title}</a>
                  </h3>
                  <div class="demo-post-meta">
                    <time class="demo-post-date" datetime={post.data.date.toISOString()}>
                      {new Date(post.data.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>
                    <span class="demo-post-reading-time">5 min read</span>
                  </div>
                  {post.data.excerpt && (
                    <p class="demo-post-excerpt">{post.data.excerpt}</p>
                  )}
                  {post.data.categories && (
                    <div class="demo-post-categories">
                      {post.data.categories.map((category: string) => (
                        <span class="demo-category">{category}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </div>
        )}

        <div class="demo-actions">
          <a href={`${import.meta.env.BASE_URL}blog`} class="btn btn-primary">View Blog</a>
        </div>
      </div>
    </section>
